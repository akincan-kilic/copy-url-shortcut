{
  "manifest_version": 3,
  "name": "Copy URL Shortcut",
  "version": "1.1.0",
  "description": "Copy the current tab URL with one shortcut. Dormant until invoked.",
  "homepage_url": "https://github.com/akincan-kilic/copy-url-shortcut",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png",
    "64": "icons/icon64.png"
  },
  "action": {
    "default_title": "Copy URL settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png",
      "64": "icons/icon64.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite",
    "offscreen",
    "storage"
  ],
  "commands": {
    "copy-url": {
      "suggested_key": {
        "default": "Ctrl+Shift+C",
        "mac": "Command+Shift+C"
      },
      "description": "Copy the current tab URL"
    },
    "copy-url-markdown": {
      "description": "Copy the current page as a Markdown link"
    }
  }
}
